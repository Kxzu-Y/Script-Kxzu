    )
end)

returnBtn.Activated:Connect(function()
    local root = characterParts()
    if not savedCFrame then
        pointStatus.Text = "Sauvegarde un point en premier"
        return
    end
    if not root then
        pointStatus.Text = "Personnage indisponible"
        return
    end
    root.CFrame = savedCFrame
    pointStatus.Text = "Retour demandé"
end)

