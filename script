    local _, humanoid = characterParts()
    if humanoid then
        humanoid.WalkSpeed = speedEnabled and currentSpeed or normalSpeed
    end
end)

-- Navigation visuelle
local function showPage(page)
    heading.Text = page
    pointPanel.Visible = page ~= "Movement"
    speedPanel.Visible = page ~= "SetPoint"

    if page == "Movement" then
        speedPanel.Position = UDim2.fromOffset(2, 65)
        speedPanel.Size = UDim2.new(1, -4, 0, 157)
    else
        speedPanel.Position = UDim2.fromOffset(2, 203)
        speedPanel.Size = UDim2.new(1, -4, 0, 157)
    end

    if page == "SetPoint" then
        pointPanel.Position = UDim2.fromOffset(2, 65)
    else
        pointPanel.Position = UDim2.fromOffset(2, 65)
    end
end

homeTab.Activated:Connect(function()
    pointPanel.Visible = true
