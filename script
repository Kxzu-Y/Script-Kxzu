local function setSpeed(value)
    currentSpeed = math.clamp(
        math.floor(tonumber(value) or 16), MIN_SPEED, MAX_SPEED
    )
    speedBox.Text = tostring(currentSpeed)
    local alpha = (currentSpeed - MIN_SPEED) /
        (MAX_SPEED - MIN_SPEED)
    fill.Size = UDim2.new(alpha, 0, 1, 0)
    knob.Position = UDim2.new(alpha, 0, 0.5, 0)

    local _, humanoid = characterParts()
    if humanoid then
        humanoid.WalkSpeed = speedEnabled and currentSpeed or normalSpeed
    end
end

speedBox.FocusLost:Connect(function()
    setSpeed(speedBox.Text)
end)

local sliderDragging = false

local function updateSlider(input)
    local x = math.clamp(
        (input.Position.X - track.AbsolutePosition.X) /
        track.AbsoluteSize.X, 0, 1
    )
    setSpeed(MIN_SPEED + x * (MAX_SPEED - MIN_SPEED))
end

track.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        sliderDragging = true
        updateSlider(input)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if sliderDragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        updateSlider(input)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        sliderDragging = false
    end
end)

