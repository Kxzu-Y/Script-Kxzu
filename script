    pointPanel.Position = UDim2.fromOffset(2, 65)
    speedPanel.Position = UDim2.fromOffset(2, 203)
    heading.Text = "Dashboard"
end)

movementTab.Activated:Connect(function()
    showPage("Movement")
end)

pointTab.Activated:Connect(function()
